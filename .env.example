# Copy to .env and fill in the values. Never commit .env.

# development | production
APP_ENV=development

# Anthropic: API key from the Claude Console.
ANTHROPIC_API_KEY=
# Model ID, confirmed in the official Anthropic docs before use.
LLM_MODEL=

# Voyage AI: API key from the Voyage dashboard.
VOYAGE_API_KEY=
# Embedding model and its vector dimension, from the official Voyage docs.
EMBEDDING_MODEL=
EMBEDDING_DIM=

# Postgres with pgvector, for example postgresql://user:password@localhost:5432/safrinha
DATABASE_URL=
